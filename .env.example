# ============================================
# Context-Driven AI QA Agent — Environment Template
# Copy this to .env.staging and fill in your values
# ============================================

# Base URLs
BASE_URL=https://kbd.nop-station.site
ADMIN_URL=https://kbd.nop-station.site/Admin

# Admin Credentials
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-admin-password

# Customer Credentials (for storefront tests)
CUSTOMER_EMAIL=your-customer@example.com
CUSTOMER_PASSWORD=your-customer-password

# Playwright Settings
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=45000
NAVIGATION_TIMEOUT=60000

# Reporting
ALLURE_RESULTS_DIR=allure-results

# Rate Limiting
REQUEST_DELAY_MS=500

# Loop Engineering
MAX_LOOP_A_ITERATIONS=5
MAX_LOOP_B_ITERATIONS=5

# Environment identifier
ENV=staging

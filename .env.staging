# Base URLs
BASE_URL=https://kbd.nop-station.site
ADMIN_URL=https://kbd.nop-station.site/Admin

# Admin Credentials
ADMIN_EMAIL=ashadul.kibria@brainstation-23.com
ADMIN_PASSWORD=ashadul.kibria@brainstation-23.com

# Customer Credentials (for storefront tests)
CUSTOMER_EMAIL=userKBD@gmail.com
CUSTOMER_PASSWORD=0123456789

# Playwright Settings
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000

# Reporting
ALLURE_RESULTS_DIR=allure-results

# Rate Limiting (ms between requests during live verification)
REQUEST_DELAY_MS=500

# Loop Engineering
MAX_LOOP_A_ITERATIONS=5
MAX_LOOP_B_ITERATIONS=5

# Environment identifier
ENV=staging
